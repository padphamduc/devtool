{
  "manifest_version": 3,
  "name": "DUC TOOL - Facebook Group List",
  "version": "1.1.0",
  "description": "Quét danh sách nhóm Facebook: tên, ID, liên kết và ảnh đại diện.",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "host_permissions": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "DUC TOOL - Facebook Group List",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
